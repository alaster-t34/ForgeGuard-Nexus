[Unit]
Description=ForgeGuard Nexus Industrial AI Agent Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forgeguard
WorkingDirectory=/opt/forgeguard-nexus
Environment=PYTHONPATH=/opt/forgeguard-nexus/backend
ExecStart=/opt/forgeguard-nexus/deploy/linux/run-native.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/forgeguard-nexus/runtime-data /opt/forgeguard-nexus/artifacts

[Install]
WantedBy=multi-user.target
