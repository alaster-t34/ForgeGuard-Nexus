# Large generated CSV expansions of OpenEval-RM; compact NPZ + metadata stay tracked.
data/openeval/ForgeGuard-OpenEval-RM-v0.1.0-waveform-csv/train_merged.csv
data/openeval/ForgeGuard-OpenEval-RM-v0.1.0-waveform-csv/test_merged.csv

# Raw rig evidence may contain proprietary operating data and large waveforms.
artifacts/bench-evidence/

# Local benchmark scratch and optional training logs.
artifacts/visual-benchmarks/checkpoints/
artifacts/visual-benchmarks/runs/

