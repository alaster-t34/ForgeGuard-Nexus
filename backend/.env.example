FORGEGUARD_ENVIRONMENT=development
FORGEGUARD_CORS_ORIGINS=http://localhost:5173
FORGEGUARD_SEARCH_PROVIDER=offline
FORGEGUARD_ALLOW_EXTERNAL_SEARCH=false
# Optional auditable read-only search proxy:
# FORGEGUARD_SEARCH_PROVIDER=searxng
# FORGEGUARD_SEARXNG_BASE_URL=http://localhost:8080
# Optional OpenAI-compatible reasoning provider; deterministic logic remains the safety gate:
# FORGEGUARD_LLM_PROVIDER=openai-compatible
# FORGEGUARD_LLM_BASE_URL=https://example.invalid/v1
# FORGEGUARD_LLM_MODEL=your-model
# FORGEGUARD_LLM_API_KEY=store-in-a-secret-manager
