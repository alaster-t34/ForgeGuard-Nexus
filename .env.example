# Core
FORGEGUARD_ENVIRONMENT=development
FORGEGUARD_DATABASE_URL=sqlite:///./forgeguard.db

# The default is a fully offline, deterministic and reproducible competition path.
FORGEGUARD_ALLOW_EXTERNAL_SEARCH=false
FORGEGUARD_SEARCH_PROVIDER=offline
FORGEGUARD_SEARCH_TIMEOUT_SECONDS=8
FORGEGUARD_SEARCH_MAX_RESULTS=8

# Optional controlled web search. Deploy your own SearXNG and enable only through policy review.
# FORGEGUARD_ALLOW_EXTERNAL_SEARCH=true
# FORGEGUARD_SEARCH_PROVIDER=searxng
# FORGEGUARD_SEARXNG_BASE_URL=https://search.example.org

# Optional OpenAI-compatible reasoning provider. It may explain and plan, but cannot bypass typed gates.
FORGEGUARD_LLM_PROVIDER=deterministic
# FORGEGUARD_LLM_PROVIDER=openai-compatible
# FORGEGUARD_LLM_BASE_URL=https://api.example.org/v1
# FORGEGUARD_LLM_MODEL=your-model
# FORGEGUARD_LLM_API_KEY=replace-at-deployment-time
